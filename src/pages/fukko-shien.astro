      var OPEN = new Date(2026, 8, 7); // 2026-09-07
      var CLOSE = new Date(2026, 8, 17, 23, 59, 59); // 2026-09-17 末
      var now = new Date();
      var banner = document.getElementById('status-banner');
      var label = document.getElementById('status-label');
      var note = document.getElementById('status-note');
      if (!banner || !label || !note) return;

      if (now < OPEN) {
        label.textContent = '9月7日（月）から受付を開始します';
        note.textContent =
          '募集期間は令和8年9月7日（月）〜9月17日（木）です。それまでは申込フォームを送信できませんので、内容をご確認のうえ9月7日以降にお申し込みください。';
      } else if (now > CLOSE) {
        banner.className = 'mb-8 rounded-xl border-2 border-gray-300 bg-gray-50 px-6 py-5 text-center';
        label.className = 'text-gray-700 font-bold text-lg mb-1';
        label.textContent = '第1次募集の受付は終了しました';
        note.textContent =
          'ご応募ありがとうございました。役員会で審査のうえ、結果は申請いただいた団体へ個別にご連絡します。追加募集を行う場合は、本ページと公式LINEでお知らせします。';
      } else {
        label.textContent = '受付中｜9月17日（木）23:59まで';
        note.textContent =
          '締切後に役員会で審査を行い、結果は申請いただいた団体へ個別にご連絡します。';
      }
    })();
