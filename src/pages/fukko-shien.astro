---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://hinokunimirai.com';
const formUrl = 'https://forms.gle/y8Czv2FMhiY8mMGt6';
const formEmbedUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSeJwXIJBTRUiassw4q1JjUSPUmD1_TGnmASax3Yjothpl4D3w/viewform?embedded=true';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: '復興支援活動助成事業', item: `${siteUrl}/fukko-shien/` },
  ],
};

// 助成事業の構造化データ（検索結果での露出向上）
const grantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  name: '令和8年熊本地震 復興支援活動助成事業',
  serviceType: '助成金',
  description:
    '令和8年熊本地震の被災地で行われる復興支援活動に対し、1団体あたり上限10万円を助成します。熊本県内で地域づくり活動を行う団体が対象です。',
  provider: { '@type': 'Organization', name: '火の国未来創造ネット', url: siteUrl },
  areaServed: { '@type': 'AdministrativeArea', name: '熊本県' },
  audience: { '@type': 'Audience', audienceType: '熊本県内の地域づくり団体・グループ・法人' },
};

const types = [
  {
    tag: '類型A',
    title: '被災された方々のケア・気分転換',
    body: '温泉・入浴施設への日帰りバス送迎、高齢者のリフレッシュ企画、被災された方の交流の場づくり など',
  },
  {
    tag: '類型B',
    title: '子ども・親子への支援活動',
    body: '子どもの遊び場・居場所づくり、キャンプ・沢登り・川遊びなどの自然体験、被災地外へ招いての体験プログラム、学習支援 など',
  },
  {
    tag: '類型C',
    title: '被災事業者・生産者の販路支援',
    body: '既存イベントでの物販ブース設置、被災地特産品の広報・販売、寄付付き商品の開発 など',
  },
  {
    tag: '類型D',
    title: '情報発信・記録・つなぎ',
    body: '被災地からの発信映像・記事の制作、支援ニーズと支援団体のマッチング、活動の記録集の作成 など',
  },
];

const eligible = [
  ['対象団体', '熊本県内で地域づくり活動を行う団体・グループ・法人。<strong>法人格の有無や種類は問いません（株式会社等も申請できます）。</strong>'],
  ['要件', '①規約・定款等があり、代表者と会計責任者が明確であること　②政治活動・宗教活動を目的とする団体でないこと　③事業終了後の実績報告と情報公開にご協力いただけること'],
  ['加盟について', '加盟団体・非加盟団体のどちらも申請できます。この機会にぜひ<a href="/join" class="text-primary-600 hover:underline">本会への加盟</a>もご検討ください。'],
  ['対象地域', '令和8年熊本地震で震度5強以上を観測した市町村を基本とします。'],
  ['事業実施期間', '交付決定日 〜 令和9年2月28日'],
];

const costsOk = [
  '会場使用料、機材・車両の借上料',
  '講師謝金、専門家への技術料',
  '参加者・スタッフの交通費（燃料費を含む）',
  '材料費、消耗品費',
  '印刷費、通信運搬費、広報費',
  '保険料（傷害保険など）',
  '飲食にかかる経費（弁当代・飲み物代・炊き出しの食材費など、事業目的に沿ったもの）',
];

const costsNg = [
  '団体の通常の運営経費（人件費・事務所家賃・光熱水費など）／運営経費のみへの充当',
  '飲食のみを目的とする経費（懇親会・打上げなど）',
  '備品の購入費（1点1万円超で、事業終了後も団体の資産として残るもの）',
  '被災された方個人への直接的な現金給付・見舞金',
  'ほかの補助金・助成金を受けている経費との重複',
];

const schedule = [
  ['9月7日（月）', '募集開始', true],
  ['9月17日（木）', '第1次募集締切（23:59）', true],
  ['締切後', '役員会で審査を行い、結果を申請団体へ個別にご連絡します', true],
  ['9月下旬〜', '採択事業の実施（〜令和9年2月28日）', false],
  ['令和9年2月頃', '成果報告イベント（ビぷれす広場等を予定）', false],
  ['令和9年3月10日（水）', '実績報告の最終締切', false],
];

const faqs = [
  {
    q: 'お弁当代や飲み物代は対象になりますか？',
    a: 'はい、事業の目的に沿った活動の一環であれば対象です。たとえば「川あそびのあと、参加者同士が話せる場として昼食を用意する」といった場合が該当します。ただし、懇親会や打上げなど飲食のみを目的とするものは対象外です。申込みの際に、その飲食が事業の中でどのような意味を持つかをご記入ください。',
  },
  {
    q: '株式会社でも申請できますか？',
    a: 'できます。法人格の有無や種類は問いません。ただし、営利のみを目的とする事業は対象外です。',
  },
  {
    q: '火の国未来創造ネットに加盟していないと申請できませんか？',
    a: 'いいえ、非加盟の団体も申請できます。この機会にぜひ加盟もご検討いただければ幸いです。',
  },
  {
    q: '被災地の外にある団体ですが、申請できますか？',
    a: 'できます。被災地域内の団体と連携して実施する事業も対象です。申込みの際に、連携先の団体名と連絡窓口をご記入ください。',
  },
  {
    q: '申請書の書き方が分かりません。',
    a: '事務局までお気軽にご相談ください。書き方のご相談も承ります。難しい書類は必要ありません。「こんなことで役に立ちたい」というお気持ちを、そのままお聞かせいただければ大丈夫です。',
  },
  {
    q: '審査結果はいつ、どのように分かりますか？',
    a: '9月17日（木）23:59の締切後に、役員会でまとめて審査します。結果は採択・不採択にかかわらず、申請いただいた団体へ個別にご連絡します。',
  },
];
---

<Layout
  title="令和8年熊本地震 復興支援活動助成事業"
  description="令和8年熊本地震の被災地で行われる復興支援活動を、1団体あたり上限10万円で助成します。募集期間は令和8年9月7日（月）〜9月17日（木）。熊本県内で地域づくり活動を行う団体・グループ・法人が対象です。"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(grantJsonLd)} slot="head" />

  <!-- ヒーロー -->
  <section class="bg-primary-600 text-white py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-primary-200 text-sm font-medium mb-2 tracking-wide">助成事業のご案内</p>
      <h1 class="text-2xl md:text-4xl font-bold mb-4 leading-snug">
        令和8年熊本地震<br class="sm:hidden" />
        復興支援活動助成事業
      </h1>
      <p class="text-primary-100 text-base md:text-lg leading-relaxed">
        被災地を応援する活動を、1団体あたり上限10万円で支援します。<br class="hidden sm:inline" />
        被災地の団体も、被災地の外から関わりたい団体も対象です。
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- パンくず -->
    <nav aria-label="パンくずリスト" class="text-sm text-gray-400 mb-8 flex items-center gap-2">
      <a href="/" class="hover:text-gray-600">トップ</a>
      <span>/</span>
      <span class="text-gray-600">復興支援活動助成事業</span>
    </nav>

    <!-- 受付ステータス（日付に応じて自動で切り替わる） -->
    <div
      id="status-banner"
      class="mb-8 rounded-xl border-2 border-primary-600 bg-primary-50 px-6 py-5 text-center"
    >
      <p id="status-label" class="text-primary-700 font-bold text-lg mb-1">
        募集期間：令和8年9月7日（月）〜 9月17日（木）23:59
      </p>
      <p id="status-note" class="text-sm text-gray-600">
        締切後に役員会で審査を行い、結果は申請いただいた団体へ個別にご連絡します。
      </p>
    </div>

    <!-- 概要ハイライト -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      {[
        { label: '1団体あたり', value: '上限 10万円', note: '消費税込み／下限1万円' },
        { label: '採択予定', value: '5件 程度', note: '総額50万円（追加あり）' },
        { label: '募集期間', value: '9/7 〜 9/17', note: '9/17（木）23:59まで受付' },
      ].map((h) => (
        <div class="card p-5 text-center">
          <p class="text-xs font-bold text-primary-700 mb-1">{h.label}</p>
          <p class="text-xl font-bold text-primary-600 mb-1">{h.value}</p>
          <p class="text-xs text-gray-500">{h.note}</p>
        </div>
      ))}
    </div>

    <!-- 代表あいさつ -->
    <section class="card p-6 sm:p-8 mb-10 bg-primary-50/40">
      <h2 class="text-lg font-bold text-primary-800 mb-5 text-center">
        令和8年熊本地震で被災された皆様へ
      </h2>
      <div class="prose prose-sm max-w-none text-gray-700 leading-relaxed">
        <p>7月28日に熊本県を襲った大きな地震から今日まで、被災地域の皆様、そして共に地域づくりに取り組む仲間の皆様に、心よりお見舞い申し上げます。</p>
        <p>私たちは、このような困難の中でも、熊本の地で地域づくりに情熱を注ぎ続けてくださっている皆様の姿勢に、深い敬意を抱いています。</p>
        <p>震災直後の緊急対応から、これからの復興、そして未来の創造へ。</p>
        <p>火の国未来創造ネットは、職種もジャンルも異なる様々な地域づくりの団体が集まる熊本県最大のネットワークです。私たちの強みは、この多くの仲間たちが手を取り合い、それぞれの専門性を活かして、困難な状況に向き合うことができるという点にあります。</p>
        <p>被災地域の皆様が、安心して暮らしを立て直し、新たな地域の姿を描くことができるよう、私たちはあらゆる支援と連携のあり方を模索してまいります。</p>
        <p>「持続可能な熊本」「豊かで実りあるネットワーク」の実現に向けて、私たちは一緒に歩んでいきます。</p>
        <p>皆様への情報提供、ご相談、そしてご意見・ご提案をお待ちしております。どのようなことでも構いません。私たちは、被災地の声に耳を傾け、一緒に考え、一緒に行動いたします。</p>
        <p>困難な今を、皆で支え合い、ともに乗り越えましょう。</p>
        <p class="text-center font-bold text-primary-700 my-4">「熊本の地域づくりを、つなぎ、ひろげる」</p>
        <p>熊本の底力、火の国の灯りが、この先も輝き続けることを願い、私たちは全力で取り組んでまいります。</p>
        <p>皆様のご無事と、一日も早い復興を、心からお祈りしています。</p>
      </div>
      <p class="text-right text-sm text-gray-600 mt-5">
        火の国未来創造ネット<br />
        <span class="font-bold text-gray-800 text-base">代表　小川　聡</span>
      </p>
    </section>

    <!-- こんな活動を応援します -->
    <section class="mb-10">
      <h2 class="section-title mb-2">こんな活動を応援します</h2>
      <p class="section-subtitle mb-6 text-sm">
        下記は例示です。これ以外のご提案も歓迎します。迷われたときは、まずは事務局までご相談ください。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {types.map((t) => (
          <div class="card p-5">
            <h3 class="font-bold text-gray-900 mb-2 flex items-start gap-2">
              <span class="badge bg-primary-600 text-white flex-shrink-0 mt-0.5">{t.tag}</span>
              <span class="text-base leading-snug">{t.title}</span>
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- お申し込みいただける団体 -->
    <section class="mb-10">
      <h2 class="section-title mb-6">お申し込みいただける団体</h2>
      <div class="card overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            {eligible.map(([label, body], i) => (
              <tr class={i > 0 ? 'border-t border-gray-100' : ''}>
                <th class="bg-gray-50 text-left font-bold text-gray-700 px-5 py-4 w-32 sm:w-40 align-top whitespace-nowrap">
                  {label}
                </th>
                <td class="px-5 py-4 text-gray-700 leading-relaxed" set:html={body} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 助成金の使いみち -->
    <section class="mb-10">
      <h2 class="section-title mb-6">助成金の使いみち</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="card p-6 border-primary-200 bg-primary-50/30">
          <h3 class="font-bold text-primary-800 mb-4 flex items-center gap-2">
            <span class="text-lg">○</span> 対象となる経費
          </h3>
          <ul class="space-y-2">
            {costsOk.map((c) => (
              <li class="text-sm text-gray-700 leading-relaxed flex gap-2">
                <span class="text-primary-500 flex-shrink-0">○</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card p-6">
          <h3 class="font-bold text-gray-600 mb-4 flex items-center gap-2">
            <span class="text-lg">×</span> 対象とならない経費
          </h3>
          <ul class="space-y-2">
            {costsNg.map((c) => (
              <li class="text-sm text-gray-600 leading-relaxed flex gap-2">
                <span class="text-gray-400 flex-shrink-0">×</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-3">
        ※ 飲食費を計上される場合は、その飲食が事業の中でどのような意味を持つかを申込みの際にご記入ください。
      </p>
    </section>

    <!-- スケジュール -->
    <section class="mb-10">
      <h2 class="section-title mb-6">スケジュール</h2>
      <div class="card overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            {schedule.map(([date, body, highlight], i) => (
              <tr class={i > 0 ? 'border-t border-gray-100' : ''}>
                <th
                  class={`text-left font-bold px-5 py-4 w-32 sm:w-44 align-top whitespace-nowrap ${
                    highlight ? 'bg-primary-50 text-primary-700' : 'bg-gray-50 text-gray-600'
                  }`}
                >
                  {date}
                </th>
                <td class="px-5 py-4 text-gray-700 leading-relaxed">{body}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 申込フォーム -->
    <section class="mb-10">
      <h2 class="section-title mb-2">お申し込み</h2>
      <p class="section-subtitle mb-6 text-sm">
        下記のフォームからお申し込みください。フォームが使いにくい場合は、申込書（様式第1号）を
        E-mail でご提出いただいても構いません。
      </p>

      <div class="card overflow-hidden mb-6">
        <div class="bg-gray-50 px-6 py-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-900 flex items-center gap-2">
            <span class="text-xl">📝</span> 申込フォーム
          </h3>
        </div>
        <div class="p-2 sm:p-4">
          <iframe
            src={formEmbedUrl}
            width="100%"
            height="1100"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            class="w-full"
            title="令和8年熊本地震 復興支援活動助成事業 申込フォーム"
            loading="lazy"
          >
            読み込んでいます…
          </iframe>
        </div>
      </div>

      <div class="text-center">
        <p class="text-sm text-gray-500 mb-3">フォームが表示されない場合はこちら</p>
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          申込フォームを別タブで開く
        </a>
      </div>
    </section>

    <!-- 資料ダウンロード -->
    <section class="mb-10">
      <h2 class="section-title mb-6">資料ダウンロード</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { href: '/docs/r8-fukko-koubo-annai.pdf', name: '公募案内', ext: 'PDF', note: 'A4・2ページ／配布用', dl: '令和8年熊本地震復興支援活動助成事業_公募案内.pdf' },
          { href: '/docs/r8-fukko-jisshi-youkou.docx', name: '実施要項', ext: 'Word', note: '助成の条件を定めた本体', dl: '令和8年熊本地震復興支援活動助成事業_実施要項.docx' },
          { href: '/docs/r8-fukko-moushikomisho.docx', name: '申込書（様式第1号）', ext: 'Word', note: 'メール提出用の様式', dl: '令和8年熊本地震復興支援活動助成事業_申込書.docx' },
        ].map((d) => (
          <a
            href={d.href}
            download={d.dl}
            class="card p-5 flex flex-col gap-2 hover:border-primary-300 transition-colors"
          >
            <span class="badge bg-gray-100 text-gray-600 self-start">{d.ext}</span>
            <span class="font-bold text-gray-900 text-sm leading-snug">{d.name}</span>
            <span class="text-xs text-gray-500">{d.note}</span>
            <span class="text-primary-600 text-xs font-medium mt-1 inline-flex items-center gap-1">
              ダウンロード
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- よくあるご質問 -->
    <section class="mb-10">
      <h2 class="section-title mb-6">よくあるご質問</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="card p-5 group">
            <summary class="font-bold text-gray-900 cursor-pointer text-sm flex items-start gap-2 list-none">
              <span class="text-primary-600 flex-shrink-0">Q.</span>
              <span class="flex-1">{f.q}</span>
              <span class="text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0">▾</span>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-4 pl-6">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- お問い合わせ -->
    <section class="card p-6 sm:p-8 bg-gray-50 text-center">
      <h2 class="font-bold text-gray-900 mb-3">お問い合わせ・提出先</h2>
      <p class="text-sm text-gray-600 leading-relaxed mb-4">
